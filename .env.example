# Optional. Only needed to sign and publish events to Nostr relays. Use a key made just for the
# publisher (never a wallet seed or wallet private key). Without it TRONostr runs in local mode.
NOSTR_PRIVATE_KEY=
# Optional. Public TronGrid works without a key but is rate limited.
TRON_PRO_API_KEY=
# Optional overrides for the local JSON API.
# TRONOSTR_API_HOST=127.0.0.1
# TRONOSTR_API_PORT=8788
# TRONOSTR_CONFIG=./config.yaml
