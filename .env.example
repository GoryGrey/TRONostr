# Optional. Only needed to sign and publish events to Nostr relays. Use a key created ONLY for this
# publisher (never a wallet seed, wallet private key, or your personal Nostr identity key).
# Accepts 64-char hex or nsec1... . Without it TRONostr runs in local mode and signs nothing.
# Never commit a real value; .env is git-ignored.
TRONOSTR_PUBLISHER_KEY=
# Alternative: path to a file containing the key (Docker/Fly/Render secret files).
# TRONOSTR_PUBLISHER_KEY_FILE=/run/secrets/tronostr_publisher_key
# Legacy name, still accepted (deprecated): NOSTR_PRIVATE_KEY=

# Optional. Public TronGrid works without a key but is limited to ~3 req/s; a free TronGrid key
# (100k requests/day) is recommended for an always-on instance.
TRON_PRO_API_KEY=

# Optional overrides for the API / dashboard.
# TRONOSTR_API_HOST=127.0.0.1
# TRONOSTR_API_PORT=8788
# PORT=8788
# TRONOSTR_CONFIG=./config.yaml

# Optional history storage overrides.
# TRONOSTR_DB_PATH=./storage/tronostr.db
# TRONOSTR_RETENTION_DAYS=30
# TRONOSTR_HISTORY=off
# Resume from the last processed block after a restart (recommended for always-on hosts).
# TRONOSTR_CHECKPOINT_PATH=./storage/tronostr-checkpoints.json
